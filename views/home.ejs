<%- include('partials/head', { pageTitle: '2w12.one — the sound thing', loggedIn: loggedIn }) %>

<div class="relative z-10 max-w-[1100px] mx-auto px-6 text-center">

  <!-- Hero: the wordmark and a terminal that types itself. Nothing else. -->
  <section class="pt-12 md:pt-14 pb-14">

    <%# Spectral-peak fingerprint, above the title. Structured fake for now —
        see fingerprint.js. %>
    <div class="mx-auto max-w-[820px] mb-12">
      <div class="flex items-baseline justify-between mb-1.5">
        <span class="font-mono text-[8.5px] uppercase tracking-[0.2em] text-muted/40">Spectral peaks &middot; 60 Hz &ndash; 12 kHz</span>
        <span class="font-mono text-[8.5px] uppercase tracking-[0.2em] text-muted/25">fingerprint</span>
      </div>
      <div id="fingerprint" class="w-full" style="height:58px" aria-hidden="true"></div>
    </div>

    <h1 class="glitch inline-block font-extrabold leading-[0.9] tracking-[-0.035em] text-white"
        style="font-size:clamp(2.3rem,5.6vw,4.4rem)" data-text="2w12.one">2w12.one</h1>

    <div class="mt-5 font-mono font-semibold uppercase tracking-[0.26em] text-accent"
         style="font-size:clamp(1rem,2.5vw,1.9rem)">
      The Sound Thing
    </div>
    <div class="mt-2.5 font-mono uppercase tracking-[0.24em] text-muted"
         style="font-size:clamp(.66rem,1.15vw,.88rem)">
      All Things Sound
    </div>

    <%# Not a fake window — just typed lines sitting on the page. The window
        chrome read as a gimmick. Typed by /js/home.js; the text is in the DOM
        so no-JS and reduced-motion get it immediately. %>
    <div class="mx-auto max-w-[620px] mt-10 text-left">

      <div class="flex items-center gap-1.5 mb-4">
        <span class="term-led w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span class="font-mono text-[9.5px] uppercase tracking-[0.2em] text-muted/60">live</span>
      </div>

      <div id="term" class="font-mono leading-[1.8] flex flex-col justify-end"
           style="font-size:clamp(.78rem,1.2vw,.92rem); min-height:12.5rem">
        <div class="term-line flex gap-2.5 mb-2">
          <span class="text-accent flex-shrink-0">$</span>
          <span class="min-w-0"><span class="term-body text-ink/90">cat status</span></span>
        </div>

        <% statusLines.forEach(function (l) { %>
          <div class="term-line flex gap-2.5 mb-1">
            <span class="text-muted/40 flex-shrink-0">&gt;</span>
            <span class="min-w-0">
              <span class="term-label text-accent"><%= l.label %>:</span>
              <span class="term-body text-ink/70"><%= l.body %></span><% if (l.note) { %>
              <span class="term-note text-muted/50"><%= l.note %></span><% } %>
            </span>
          </div>
        <% }) %>

        <% if (!statusLines.length) { %>
          <div class="text-muted/60">status: empty</div>
        <% } %>

        <div class="term-line flex gap-2.5 mt-3">
          <span class="term-prompt text-accent flex-shrink-0">$</span>
          <span id="term-idle" class="min-w-0"></span>
        </div>
      </div>
    </div>

  </section>

</div>
<script src="/js/fingerprint.js"></script>
<script src="/js/home.js"></script>
</body>
</html>
