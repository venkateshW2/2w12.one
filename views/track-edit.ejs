<%- include('partials/head', { pageTitle: 'Edit — ' + track.title, loggedIn: true }) %>

<div class="max-w-3xl mx-auto px-5 py-8">
  <a href="/dashboard" class="text-xs text-accent hover:underline">&larr; Back to dashboard</a>
  <h1 class="text-lg font-semibold mt-3 mb-6">Edit: <%= track.title %></h1>

  <form method="POST" action="/dashboard/tracks/<%= track.id %>/edit" enctype="multipart/form-data" class="grid md:grid-cols-2 gap-4">
    <div class="md:col-span-2">
      <label class="block text-xs text-muted mb-1">Title</label>
      <input type="text" name="title" value="<%= track.title %>" required class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>

    <div>
      <label class="block text-xs text-muted mb-1">Current link</label>
      <input type="text" name="source_url" value="<%= track.type === 'link' ? track.source_url : '' %>" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Replace with an uploaded file</label>
      <input type="file" name="media_file" accept="audio/*,video/*" class="text-xs">
    </div>

    <div>
      <label class="block text-xs text-muted mb-1">Cover image</label>
      <% if (track.cover_image_url) { %><img src="<%= track.cover_image_url %>" class="w-24 h-14 object-cover rounded mb-1.5 bg-bg" alt=""><% } %>
      <input type="text" name="cover_image_url" value="<%= track.cover_image_url || '' %>" placeholder="/images/projects/GOW.png or https://..." class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      <label class="block text-xs text-muted mt-2 mb-1">Replace by uploading</label>
      <input type="file" name="cover_file" accept="image/*" class="text-xs">
      <div class="text-[10px] text-muted mt-1">Clear the URL field to remove the cover (YouTube links fall back to their own thumbnail).</div>
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Badge &mdash; the orange tag on the card</label>
      <input type="text" name="role" value="<%= track.role || '' %>" list="badge-options" autocomplete="off"
             placeholder="Type anything, e.g. Sound Design + Mix"
             class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      <datalist id="badge-options">
        <% roles.forEach(function(r) { %><option value="<%= r %>"></option><% }) %>
      </datalist>
      <div class="text-[10px] text-muted mt-1">Free text &mdash; whatever you type is exactly what the card shows. Empty = no badge.</div>
    </div>

    <div class="md:col-span-2">
      <label class="block text-xs text-muted mb-2">Category</label>
      <div class="flex flex-wrap gap-3">
        <% var current = (track.tags || '').split(',').map(function(s){return s.trim().toUpperCase();}); %>
        <% tagOrder.forEach(function(tag) { %>
          <label class="flex items-center gap-1.5 text-xs text-muted">
            <input type="checkbox" name="tags" value="<%= tag %>" <%= current.indexOf(tag) !== -1 ? 'checked' : '' %>> <%= tagLabels[tag] %>
          </label>
        <% }) %>
      </div>
    </div>

    <div>
      <label class="block text-xs text-muted mb-1">Nest under</label>
      <select name="parent_track_id" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
        <option value="">— top-level project —</option>
        <% parentCandidates.forEach(function(t) { %><option value="<%= t.id %>" <%= track.parent_track_id === t.id ? 'selected' : '' %>><%= t.title %></option><% }) %>
      </select>
    </div>
    <div class="flex items-end gap-4">
      <label class="flex items-center gap-1.5 text-xs text-muted mb-2">
        <input type="checkbox" name="featured" <%= track.featured ? 'checked' : '' %>> Featured
      </label>
      <div>
        <label class="block text-xs text-muted mb-1">Pin (higher = further up)</label>
        <input type="number" name="sort_order" value="<%= track.sort_order || 0 %>" class="w-24 bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      </div>
    </div>

    <div>
      <label class="block text-xs text-muted mb-1">Year</label>
      <input type="number" name="year" value="<%= track.year || '' %>" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Collaboration</label>
      <input type="text" name="collaboration" value="<%= track.collaboration || '' %>" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Location</label>
      <input type="text" name="location" value="<%= track.location || '' %>" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Technical</label>
      <input type="text" name="technical" value="<%= track.technical || '' %>" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Project page link (IMDb, GitHub, official site)</label>
      <input type="text" name="external_url" value="<%= track.external_url || '' %>" placeholder="https://..." class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div class="md:col-span-2 border border-accent/25 bg-accent/[0.04] rounded p-3">
      <label class="flex items-center gap-2 text-xs text-ink">
        <input type="checkbox" name="solo_credit" <%= track.solo_credit ? 'checked' : '' %>> Solo &mdash; I handled every department on this
      </label>
      <input type="text" name="credit_note" value="<%= track.credit_note || '' %>" placeholder="What exactly, e.g. 'Solo — recording, sound design, mix. Masters thesis project.'" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm mt-2 focus:outline-none focus:border-accent">
    </div>
    <div class="md:col-span-2">
      <label class="block text-xs text-muted mb-1">Description / context</label>
      <textarea name="description" rows="3" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent"><%= track.description || '' %></textarea>
    </div>

    <div class="md:col-span-2">
      <button type="submit" class="bg-accent text-bg text-sm font-medium rounded px-4 py-2 hover:brightness-110 transition">Save changes</button>
    </div>
  </form>
</div>
</body>
</html>
