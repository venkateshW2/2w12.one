<%- include('partials/head', { pageTitle: profile.name + ' — Work', loggedIn: loggedIn }) %>

<div class="max-w-7xl mx-auto px-5 py-7 flex flex-col md:flex-row gap-7">

  <!-- Sidebar: about + player -->
  <aside class="md:w-[266px] flex-shrink-0">
    <div class="md:sticky md:top-[52px] space-y-3">

      <div class="bg-surface border border-line rounded-lg p-5">
        <div class="flex items-center gap-3">
          <% if (profile.avatar_url) { %>
            <img src="<%= profile.avatar_url %>" alt="<%= profile.name %>" class="w-14 h-14 rounded-full object-cover object-top border border-line flex-shrink-0">
          <% } else { %>
            <%# No headshot uploaded yet — initials keep the layout honest
                instead of leaving a hole where a face should be. %>
            <div class="w-14 h-14 rounded-full border border-line bg-bg flex items-center justify-center flex-shrink-0 font-medium text-accent text-base tracking-wide">
              <%= profile.name.split(' ').map(function(w){return w[0];}).join('').slice(0,2).toUpperCase() %>
            </div>
          <% } %>
          <div class="min-w-0">
            <div class="text-[15px] font-semibold leading-tight tracking-tight"><%= profile.name %></div>
            <% if (profile.tagline) { %><div class="text-[11px] text-muted mt-1 font-mono uppercase tracking-[0.08em]"><%= profile.tagline %></div><% } %>
          </div>
        </div>

        <% if (profile.bio_long) { %>
          <p class="text-[12.5px] leading-[1.65] text-ink/75 mt-4"><%= profile.bio_long %></p>
        <% } %>

        <% if (profile.education) { %>
          <div class="mt-4 pt-4 border-t border-line">
            <div class="text-[9.5px] font-mono uppercase tracking-[0.14em] text-muted/80 mb-2">Education</div>
            <ul class="space-y-1.5">
              <% profile.education.split('\n').filter(Boolean).forEach(function(line) { %>
                <li class="text-[11.5px] leading-snug text-ink/65"><%= line %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class="mt-4 pt-4 border-t border-line">
          <a href="/portfolio/gallery" class="flex items-center justify-between group text-[11.5px] text-muted hover:text-accent transition-colors">
            <span>Gallery &mdash; tests &amp; experiments</span>
            <span class="text-accent/60 group-hover:text-accent transition-colors">&rarr;</span>
          </a>
        </div>

        <div class="mt-4 pt-4 border-t border-line flex flex-col gap-2 text-[11.5px]">
          <% if (profile.email) { %><a href="mailto:<%= profile.email %>" class="text-muted hover:text-accent transition-colors"><%= profile.email %></a><% } %>
          <% if (profile.website_url) { %><a href="<%= profile.website_url %>" target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">Website</a><% } %>
          <% if (profile.linkedin_url) { %><a href="<%= profile.linkedin_url %>" target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">LinkedIn</a><% } %>
        </div>
      </div>

      <!-- Stream player -->
      <div id="player" class="bg-surface border border-line rounded-lg overflow-hidden">
        <div class="flex items-center justify-between px-4 pt-3.5 pb-2">
          <div class="text-[9.5px] font-mono uppercase tracking-[0.14em] text-muted/80">Player</div>
          <div id="pl-count" class="text-[9.5px] font-mono text-muted/60"></div>
        </div>

        <div id="pl-empty" class="px-4 pb-4 text-[11.5px] leading-relaxed text-muted">
          No streamable audio yet. Tracks added as direct audio links &mdash; or uploaded once B2 is reachable &mdash; show up here as a playlist.
        </div>

        <div id="pl-body" class="hidden">
          <div class="px-4 pb-3 flex items-center gap-3">
            <img id="pl-cover" src="" alt="" class="w-11 h-11 rounded object-cover bg-bg flex-shrink-0">
            <div class="min-w-0 flex-1">
              <div id="pl-title" class="text-[12.5px] truncate leading-tight"></div>
              <div id="pl-project" class="text-[10.5px] text-muted truncate mt-0.5"></div>
            </div>
          </div>

          <div class="px-4">
            <div id="pl-seek" class="group relative h-1 bg-line rounded-full cursor-pointer">
              <div id="pl-progress" class="absolute inset-y-0 left-0 bg-accent rounded-full" style="width:0%"></div>
              <div id="pl-knob" class="absolute top-1/2 -translate-y-1/2 -ml-1.5 w-3 h-3 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity" style="left:0%"></div>
            </div>
            <div class="flex justify-between mt-1.5 text-[9.5px] font-mono text-muted/70">
              <span id="pl-now">0:00</span><span id="pl-dur">0:00</span>
            </div>
          </div>

          <div class="flex items-center justify-center gap-5 py-3">
            <button id="pl-prev" type="button" class="text-muted hover:text-accent transition-colors" aria-label="Previous track">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M7 6h2v12H7zm3 6l8-6v12z"/></svg>
            </button>
            <button id="pl-toggle" type="button" class="w-9 h-9 rounded-full bg-accent text-bg flex items-center justify-center hover:brightness-110 transition" aria-label="Play or pause">
              <svg id="pl-icon-play" viewBox="0 0 24 24" class="w-3.5 h-3.5 ml-0.5" fill="currentColor"><polygon points="5,3 21,12 5,21"/></svg>
              <svg id="pl-icon-pause" viewBox="0 0 24 24" class="w-3.5 h-3.5 hidden" fill="currentColor"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg>
            </button>
            <button id="pl-next" type="button" class="text-muted hover:text-accent transition-colors" aria-label="Next track">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M15 6h2v12h-2zm-1 6L6 18V6z"/></svg>
            </button>
          </div>

          <div id="pl-list" class="max-h-56 overflow-y-auto border-t border-line"></div>
        </div>
      </div>

    </div>
  </aside>

  <!-- Main: category tabs + card grid -->
  <main class="min-w-0 flex-1">

    <!-- Folder tabs: filter in place so nothing needs scrolling -->
    <div class="sticky top-[48px] z-30 -mx-1 px-1 pt-1 pb-2.5 bg-bg/95 backdrop-blur">
      <div class="relative flex items-end">
        <button id="tab-left" type="button" class="tab-arrow flex-shrink-0 pr-1.5 text-muted hover:text-accent self-center" aria-label="Scroll tabs left">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15,5 8,12 15,19"/></svg>
        </button>

        <div class="relative flex-1 min-w-0">
          <div id="tab-strip" class="flex items-end gap-0.5 overflow-x-auto no-scrollbar scroll-smooth">
            <button type="button" data-cat="" class="cat-tab active">All <span class="tab-count"><%= items.length %></span></button>
            <% categories.forEach(function(c) { %>
              <button type="button" data-cat="<%= c.tag %>" class="cat-tab"><%= c.label %> <span class="tab-count"><%= c.count %></span></button>
            <% }) %>
          </div>
          <div id="tab-fade-l" class="tab-fade absolute inset-y-0 left-0 w-8" style="background:linear-gradient(to right,#0c0c0c,transparent)"></div>
          <div id="tab-fade-r" class="tab-fade absolute inset-y-0 right-0 w-8" style="background:linear-gradient(to left,#0c0c0c,transparent)"></div>
        </div>

        <button id="tab-right" type="button" class="tab-arrow flex-shrink-0 pl-1.5 text-muted hover:text-accent self-center" aria-label="Scroll tabs right">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9,5 16,12 9,19"/></svg>
        </button>
      </div>
      <div class="h-px bg-line -mt-px"></div>
    </div>

    <div id="grid" class="grid gap-4 pt-4" style="grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));">
      <% items.forEach(function(item) { %>
        <article class="project-card group relative bg-surface border border-line rounded-md overflow-hidden cursor-pointer<%= item.soloCredit ? ' solo-credit' : '' %>"
                 data-id="<%= item.id %>" data-tags="<%= item.tags.join(',') %>">

          <div class="relative aspect-[16/9] bg-bg overflow-hidden">
            <% if (item.cover) { %>
              <img src="<%= item.cover %>" loading="lazy" alt="<%= item.title %>" class="card-img w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-muted/40">
                <% if (item.tags.indexOf('SOFTWARE') !== -1 || item.tags.indexOf('RESEARCH') !== -1) { %>
                  <svg viewBox="0 0 24 24" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="8,6 3,12 8,18"/><polyline points="16,6 21,12 16,18"/><line x1="13.5" y1="4.5" x2="10.5" y2="19.5"/>
                  </svg>
                <% } else { %>
                  <svg viewBox="0 0 24 24" class="w-8 h-8" fill="currentColor"><path d="M12 3v10.55A4 4 0 1014 17V7h4V3h-6z"/></svg>
                <% } %>
              </div>
            <% } %>

            <% if (item.roleShort) { %>
              <div class="absolute top-2 left-2 max-w-[calc(100%-1rem)] text-[8.5px] font-mono font-medium uppercase tracking-wider text-bg bg-accent/95 px-1.5 py-0.5 rounded-sm truncate">
                <%= item.roleShort %>
              </div>
            <% } %>
            <% if (item.soloCredit) { %>
              <div class="absolute top-2 <%= item.roleShort ? 'left-2 mt-[17px]' : 'left-2' %> text-[8.5px] font-mono font-semibold uppercase tracking-wider text-accent border border-accent/70 bg-bg/85 px-1.5 py-0.5 rounded-sm backdrop-blur-sm">
                Solo &middot; All departments
              </div>
            <% } %>
            <% if (item.isAlbum) { %>
              <div class="absolute top-2 right-2 text-[9px] font-mono text-ink bg-black/60 px-1.5 py-0.5 rounded-sm"><%= item.pieces.length %> pieces</div>
            <% } %>
            <% if (item.src) { %>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                <div class="w-11 h-11 rounded-full bg-black/55 border border-white/40 flex items-center justify-center backdrop-blur-sm">
                  <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 ml-0.5"><polygon points="5,3 21,12 5,21" fill="#fff"/></svg>
                </div>
              </div>
            <% } %>
          </div>

          <div class="p-4">
            <div class="flex items-baseline justify-between gap-2 mb-1.5">
              <div class="text-[9.5px] font-mono uppercase tracking-[0.12em] text-muted truncate">
                <%= item.tags.map(function(t){ return t === 'MORE' ? 'Other' : t; }).join(' &middot; ') %>
              </div>
              <% if (item.year) { %><div class="text-[9.5px] font-mono text-muted flex-shrink-0"><%= item.year %></div><% } %>
            </div>

            <h3 class="project-title text-[15px] leading-snug font-medium tracking-tight transition-colors"><%= item.title %></h3>
            <% if (item.role) { %><div class="text-[11.5px] italic text-muted mt-0.5"><%= item.role %></div><% } %>

            <% if (item.description) { %>
              <p class="card-desc text-[12px] leading-[1.6] text-ink/70 mt-2.5"><%= item.description %></p>
            <% } %>

            <div class="card-details">
              <div class="pt-3 mt-3 border-t border-line space-y-1.5">
                <% if (item.creditNote) { %>
                  <div class="text-[11.5px] text-accent leading-relaxed mb-2 pl-2 border-l-2 border-accent/60"><%= item.creditNote %></div>
                <% } %>
                <% if (item.collaboration) { %><div class="text-[11px]"><span class="text-muted">Collaboration:</span> <span class="text-ink/80"><%= item.collaboration %></span></div><% } %>
                <% if (item.technical) { %><div class="text-[11px]"><span class="text-muted">Technical:</span> <span class="text-ink/80"><%= item.technical %></span></div><% } %>
                <% if (item.location) { %><div class="text-[11px]"><span class="text-muted">Location:</span> <span class="text-ink/80"><%= item.location %></span></div><% } %>
                <% if (item.context) { %><div class="text-[11px]"><span class="text-muted">Context:</span> <span class="text-ink/80"><%= item.context %></span></div><% } %>

                <% if (item.isAlbum) { %>
                  <div class="pt-2">
                    <div class="text-[10px] font-mono uppercase tracking-wider text-muted mb-1">Tracks</div>
                    <% item.pieces.forEach(function(p) { %>
                      <div class="piece-play flex items-baseline gap-1.5 py-0.5 text-[11.5px] text-muted hover:text-accent transition-colors" data-play="<%= p.id %>">
                        <span class="text-accent/60">&#9656;</span>
                        <span class="truncate"><%= p.title %></span>
                        <% if (p.roleShort) { %><span class="text-[9px] text-muted/70 flex-shrink-0">&middot; <%= p.roleShort %></span><% } %>
                      </div>
                    <% }) %>
                  </div>
                <% } %>

                <div class="flex items-center flex-wrap gap-2 pt-3">
                  <% if (item.src) { %>
                    <button type="button" class="card-play text-[10px] font-mono uppercase tracking-wider border border-accent/60 text-accent rounded px-2.5 py-1 hover:bg-accent hover:text-bg transition-colors">
                      <%= item.isAlbum ? 'Play tracks' : 'Play' %>
                    </button>
                  <% } %>
                  <% if (item.audioPieces && item.audioPieces.length) { %>
                    <button type="button" class="card-queue text-[10px] font-mono uppercase tracking-wider border border-line text-muted rounded px-2.5 py-1 hover:text-accent hover:border-accent/60 transition-colors"
                            data-queue="<%= item.audioPieces.map(function(a){return a.id;}).join(',') %>">
                      Send to player
                    </button>
                  <% } %>
                  <% if (item.externalUrl) { %>
                    <a href="<%= item.externalUrl %>" target="_blank" rel="noopener" class="card-link text-[10px] font-mono uppercase tracking-wider border border-line text-muted rounded px-2.5 py-1 hover:text-ink hover:border-muted transition-colors">
                      View project
                    </a>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="expand-indicator absolute bottom-2 right-3 text-muted/60 text-sm leading-none select-none transition-transform">+</div>
          </div>
        </article>
      <% }) %>
    </div>

    <div id="grid-empty" class="hidden pt-8 text-sm text-muted">Nothing in this category yet.</div>
    <% if (!items.length) { %><div class="pt-8 text-sm text-muted">No projects yet.</div><% } %>
  </main>
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 bg-black/92 z-50 hidden items-center justify-center p-6">
  <button id="lightbox-close" type="button" class="absolute top-5 right-6 text-2xl text-ink hover:text-accent transition-colors">&#10005;</button>
  <div class="w-full max-w-5xl max-h-[90vh] flex bg-surface border border-line">
    <div id="lb-video" class="flex-1 min-w-0 aspect-video bg-black"></div>
    <div id="lb-side" class="hidden w-60 flex-shrink-0 overflow-y-auto border-l border-line max-h-[90vh]">
      <div id="lb-title" class="text-[11px] uppercase tracking-wide text-muted px-3.5 pt-3 pb-2"></div>
      <div id="lb-pieces"></div>
    </div>
  </div>
</div>

<script>
  window.ITEMS = <%- itemsJson %>;
  window.PLAYLIST = <%- playlistJson %>;
</script>
<script src="/js/portfolio.js"></script>
</body>
</html>
