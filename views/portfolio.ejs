<%- include('partials/head', { pageTitle: profile.name + ' — Work', loggedIn: loggedIn }) %>

<div class="max-w-7xl mx-auto px-5 py-8 flex flex-col md:flex-row gap-8">

  <!-- Sidebar: About -->
  <aside class="md:w-72 flex-shrink-0">
    <div class="md:sticky md:top-20 bg-surface border border-line rounded-lg p-6">
      <% if (profile.avatar_url) { %>
        <img src="<%= profile.avatar_url %>" alt="<%= profile.name %>" class="w-24 h-24 rounded-full object-cover object-top border border-line mb-4">
      <% } %>
      <div class="text-sm font-semibold"><%= profile.name %></div>
      <% if (profile.tagline) { %><div class="text-xs text-muted mt-0.5"><%= profile.tagline %></div><% } %>

      <% if (profile.bio_long) { %>
        <p class="text-xs leading-relaxed text-ink/85 mt-4"><%= profile.bio_long %></p>
      <% } %>

      <% if (profile.education) { %>
        <ul class="mt-4 space-y-1">
          <% profile.education.split('\n').filter(Boolean).forEach(function(line) { %>
            <li class="text-[11px] text-muted">&middot; <%= line %></li>
          <% }) %>
        </ul>
      <% } %>

      <div class="mt-5 pt-4 border-t border-line flex flex-col gap-1.5 text-xs">
        <% if (profile.email) { %><a href="mailto:<%= profile.email %>" class="text-muted hover:text-accent transition-colors"><%= profile.email %></a><% } %>
        <% if (profile.website_url) { %><a href="<%= profile.website_url %>" target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">Website</a><% } %>
        <% if (profile.linkedin_url) { %><a href="<%= profile.linkedin_url %>" target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">LinkedIn</a><% } %>
      </div>
    </div>
  </aside>

  <!-- Main: project cards -->
  <main class="min-w-0 flex-1">
    <% sections.forEach(function(section) { %>
      <div class="mb-12">
        <div class="text-[11px] uppercase tracking-[0.14em] text-muted mb-4 pb-2 border-b border-line"><%= section.label %></div>
        <div class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));">
          <% section.items.forEach(function(item) { %>
            <article class="project-card group relative bg-surface border border-line rounded-md overflow-hidden cursor-pointer" data-id="<%= item.id %>">

              <!-- poster, YouTube thumbnail, or placeholder -->
              <div class="relative aspect-[16/9] bg-bg overflow-hidden">
                <% if (item.cover) { %>
                  <img src="<%= item.cover %>" loading="lazy" alt="<%= item.title %>" class="card-img w-full h-full object-cover">
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-muted/40">
                    <svg viewBox="0 0 24 24" class="w-8 h-8" fill="currentColor"><path d="M12 3v10.55A4 4 0 1014 17V7h4V3h-6z"/></svg>
                  </div>
                <% } %>

                <% if (item.roleShort) { %>
                  <div class="absolute top-2 left-2 text-[8.5px] font-medium uppercase tracking-wider text-bg bg-accent/90 px-1.5 py-0.5 rounded-sm">
                    <%= item.roleShort %>
                  </div>
                <% } %>
                <% if (item.isAlbum) { %>
                  <div class="absolute top-2 right-2 text-[9px] text-ink bg-black/60 px-1.5 py-0.5 rounded-sm"><%= item.pieces.length %> pieces</div>
                <% } %>
                <% if (item.playable !== false && item.src) { %>
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                    <div class="w-11 h-11 rounded-full bg-black/55 border border-white/40 flex items-center justify-center backdrop-blur-sm">
                      <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 ml-0.5"><polygon points="5,3 21,12 5,21" fill="#fff"/></svg>
                    </div>
                  </div>
                <% } %>
              </div>

              <!-- meta -->
              <div class="p-4">
                <div class="flex items-baseline justify-between gap-2 mb-1.5">
                  <div class="text-[9.5px] uppercase tracking-[0.12em] text-muted truncate">
                    <%= section.label %><% if (item.role) { %> &middot; <%= item.roleShort %><% } %>
                  </div>
                  <% if (item.year) { %><div class="text-[9.5px] text-muted flex-shrink-0"><%= item.year %></div><% } %>
                </div>

                <h3 class="project-title text-[15px] leading-snug font-medium transition-colors"><%= item.title %></h3>
                <% if (item.role) { %><div class="text-[11.5px] italic text-muted mt-0.5"><%= item.role %></div><% } %>

                <% if (item.description) { %>
                  <p class="card-desc text-[12px] leading-relaxed text-ink/70 mt-2.5"><%= item.description %></p>
                <% } %>

                <!-- revealed on click -->
                <div class="card-details">
                  <div class="pt-3 mt-3 border-t border-line space-y-1.5">
                    <% if (item.collaboration) { %>
                      <div class="text-[11px]"><span class="text-muted">Collaboration:</span> <span class="text-ink/80"><%= item.collaboration %></span></div>
                    <% } %>
                    <% if (item.technical) { %>
                      <div class="text-[11px]"><span class="text-muted">Technical:</span> <span class="text-ink/80"><%= item.technical %></span></div>
                    <% } %>
                    <% if (item.location) { %>
                      <div class="text-[11px]"><span class="text-muted">Location:</span> <span class="text-ink/80"><%= item.location %></span></div>
                    <% } %>
                    <% if (item.context) { %>
                      <div class="text-[11px]"><span class="text-muted">Context:</span> <span class="text-ink/80"><%= item.context %></span></div>
                    <% } %>

                    <% if (item.isAlbum) { %>
                      <div class="pt-2">
                        <div class="text-[10px] uppercase tracking-wider text-muted mb-1">Tracks</div>
                        <% item.pieces.forEach(function(p) { %>
                          <div class="piece-play flex items-baseline gap-1.5 py-0.5 text-[11.5px] text-muted hover:text-accent transition-colors" data-play="<%= p.id %>">
                            <span class="text-accent/60">&#9656;</span>
                            <span class="truncate"><%= p.title %></span>
                            <% if (p.roleShort) { %><span class="text-[9px] text-muted/70 flex-shrink-0">&middot; <%= p.roleShort %></span><% } %>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>

                    <div class="flex items-center gap-2 pt-3">
                      <% if (item.src) { %>
                        <button type="button" class="card-play text-[10px] uppercase tracking-wider border border-accent/60 text-accent rounded px-2.5 py-1 hover:bg-accent hover:text-bg transition-colors">
                          <%= item.isAlbum ? 'Play tracks' : 'Play' %>
                        </button>
                      <% } %>
                      <% if (item.externalUrl) { %>
                        <a href="<%= item.externalUrl %>" target="_blank" rel="noopener" class="card-link text-[10px] uppercase tracking-wider border border-line text-muted rounded px-2.5 py-1 hover:text-ink hover:border-muted transition-colors">
                          View project
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="expand-indicator absolute bottom-2 right-3 text-muted/60 text-sm leading-none select-none transition-transform">+</div>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    <% }) %>
    <% if (!sections.length) { %>
      <div class="text-sm text-muted">No projects yet.</div>
    <% } %>
  </main>
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 bg-black/92 z-50 hidden items-center justify-center p-6">
  <button id="lightbox-close" type="button" class="absolute top-5 right-6 text-2xl text-ink hover:text-accent transition-colors">&#10005;</button>
  <div class="w-full max-w-5xl max-h-[90vh] flex bg-surface border border-line">
    <div id="lb-video" class="flex-1 min-w-0 aspect-video bg-black"></div>
    <div id="lb-side" class="hidden w-60 flex-shrink-0 overflow-y-auto border-l border-line max-h-[90vh]">
      <div id="lb-title" class="text-[11px] uppercase tracking-wide text-muted px-3.5 pt-3 pb-2"></div>
      <div id="lb-pieces"></div>
    </div>
  </div>
</div>

<script>
  window.ITEMS = <%- itemsJson %>;
</script>
<script src="/js/portfolio.js"></script>
</body>
</html>
