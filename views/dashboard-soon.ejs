<%- include('partials/head', { pageTitle: section.title + ' — 2w12.one', loggedIn: true }) %>

<div class="max-w-5xl mx-auto px-5 py-8">
  <%- include('partials/dash-nav', { active: active }) %>

  <div class="max-w-2xl">
    <div class="inline-flex items-center gap-2.5 border border-accent/50 rounded-full px-3.5 py-1.5 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      <span class="font-mono uppercase tracking-[0.14em] text-accent text-[10px]">Coming soon</span>
    </div>

    <h1 class="text-[30px] md:text-[38px] font-bold tracking-tight leading-none"><%= section.title %></h1>
    <p class="text-[15px] leading-relaxed text-ink/75 mt-5"><%= section.lede %></p>

    <div class="mt-8 border-t border-line pt-6">
      <div class="side-label mb-4">What it will do</div>
      <ul class="space-y-3">
        <% section.points.forEach(function (pt) { %>
          <li class="flex gap-3 text-[13.5px] leading-relaxed text-muted">
            <span class="text-accent/70 flex-shrink-0 font-mono">&mdash;</span>
            <span><%= pt %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/dashboard" class="font-mono text-[10.5px] uppercase tracking-wider border border-line text-muted rounded px-4 py-2.5 hover:text-accent hover:border-accent/60 transition-colors">&larr; Edit portfolio</a>
      <a href="/portfolio" target="_blank" class="font-mono text-[10.5px] uppercase tracking-wider border border-line text-muted rounded px-4 py-2.5 hover:text-ink hover:border-muted transition-colors">View public page</a>
    </div>
  </div>
</div>
</body>
</html>
