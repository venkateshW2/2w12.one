<%- include('partials/head', { pageTitle: 'Admin — 2w12.one', loggedIn: loggedIn }) %>

<div class="max-w-5xl mx-auto px-5 py-8 space-y-8">

  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-lg font-semibold tracking-tight">Admin</h1>
      <div class="text-[11px] text-muted mt-1 font-mono uppercase tracking-[0.1em]">
        <%= people.length %> account<%= people.length === 1 ? '' : 's' %> &middot; <%= pending.length %> pending invite<%= pending.length === 1 ? '' : 's' %>
      </div>
    </div>
    <a href="/dashboard" class="text-xs text-accent hover:underline">Edit portfolio &rarr;</a>
  </div>

  <% if (error) { %><div class="text-xs text-red-400 bg-red-950/40 border border-red-900 rounded px-3 py-2"><%= error %></div><% } %>
  <% if (notice) { %><div class="text-xs text-accent bg-accent/[0.07] border border-accent/30 rounded px-3 py-2"><%= notice %></div><% } %>

  <!-- Invite -->
  <section class="bg-surface border border-line rounded-lg p-6">
    <h2 class="text-sm font-semibold mb-1.5">Invite someone</h2>
    <p class="text-[11.5px] text-muted leading-relaxed mb-4">
      Signup is invite-only &mdash; there is no public registration. Adding an email here is the only way
      someone can create a login, and they set their own password.
    </p>
    <form method="POST" action="/admin/invites" class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs text-muted mb-1">Name</label>
        <input type="text" name="name" required placeholder="Their name" class="w-full bg-bg border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      </div>
      <div>
        <label class="block text-xs text-muted mb-1">Email</label>
        <input type="email" name="email" required placeholder="them@example.com" class="w-full bg-bg border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      </div>
      <div class="md:col-span-2 flex items-center justify-between gap-4 flex-wrap">
        <label class="flex items-center gap-2 text-xs text-muted">
          <input type="checkbox" name="is_admin"> Make them an admin too
        </label>
        <button type="submit" class="bg-accent text-bg text-sm font-medium rounded px-4 py-2 hover:brightness-110 transition">Create invite</button>
      </div>
    </form>
  </section>

  <!-- Pending -->
  <% if (pending.length) { %>
    <section>
      <h2 class="text-sm font-semibold mb-3">Pending invites</h2>
      <div class="space-y-2">
        <% pending.forEach(function (i) { %>
          <div class="bg-surface border border-line rounded-lg p-3.5">
            <div class="flex items-start gap-3 flex-wrap">
              <div class="min-w-0 flex-1">
                <div class="text-sm flex items-center gap-2">
                  <%= i.name %>
                  <% if (i.is_admin) { %><span class="text-[8.5px] font-mono uppercase tracking-wider text-accent border border-accent/60 rounded px-1 py-px">admin</span><% } %>
                </div>
                <div class="text-[11px] text-muted mt-0.5"><%= i.email %></div>
              </div>
              <div class="flex items-center gap-2.5 flex-shrink-0">
                <form method="POST" action="/admin/invites/<%= i.id %>/reissue" class="inline">
                  <button type="submit" class="text-[11px] text-muted hover:text-accent transition-colors" title="Generate a new link and invalidate this one">New link</button>
                </form>
                <form method="POST" action="/admin/invites/<%= i.id %>/delete" onsubmit="return confirm('Revoke this invite?')" class="inline">
                  <button type="submit" class="text-[11px] text-red-400/80 hover:text-red-400 transition-colors">Revoke</button>
                </form>
              </div>
            </div>
            <div class="mt-2.5 flex items-center gap-2">
              <input readonly value="<%= baseUrl %>/signup/<%= i.token %>"
                     class="flex-1 min-w-0 bg-bg border border-line rounded px-2.5 py-1.5 text-[11px] font-mono text-muted focus:outline-none focus:border-accent"
                     onclick="this.select()">
              <button type="button" class="copy-link text-[10px] font-mono uppercase tracking-wider border border-line text-muted rounded px-2.5 py-1.5 hover:text-accent hover:border-accent/60 transition-colors flex-shrink-0"
                      data-link="<%= baseUrl %>/signup/<%= i.token %>">Copy</button>
            </div>
            <div class="text-[10px] text-muted/60 mt-1.5">Send this link to <%= i.email %> &mdash; it works once.</div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Accounts -->
  <section>
    <h2 class="text-sm font-semibold mb-3">Accounts</h2>
    <div class="space-y-2">
      <% people.forEach(function (p) { %>
        <div class="bg-surface border border-line rounded-lg p-3.5 flex items-center gap-3 flex-wrap">
          <div class="min-w-0 flex-1">
            <div class="text-sm flex items-center gap-2 flex-wrap">
              <%= p.name %>
              <% if (p.is_admin) { %><span class="text-[8.5px] font-mono uppercase tracking-wider text-accent border border-accent/60 rounded px-1 py-px">admin</span><% } %>
              <% if (p.id === me.id) { %><span class="text-[8.5px] font-mono uppercase tracking-wider text-muted border border-line rounded px-1 py-px">you</span><% } %>
            </div>
            <div class="text-[11px] text-muted mt-0.5"><%= p.email %> &middot; <%= p.projects %> projects</div>
          </div>
          <div class="flex items-center gap-2.5 flex-shrink-0">
            <% if (p.profileUrl) { %><a href="<%= p.profileUrl %>" target="_blank" class="text-[11px] text-accent hover:underline">Portfolio</a><% } %>
            <form method="POST" action="/admin/users/<%= p.id %>/admin" class="inline">
              <button type="submit" class="text-[11px] text-muted hover:text-accent transition-colors">
                <%= p.is_admin ? 'Remove admin' : 'Make admin' %>
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (accepted.length) { %>
    <section>
      <h2 class="text-sm font-semibold mb-3">Used invites</h2>
      <div class="space-y-1.5">
        <% accepted.forEach(function (i) { %>
          <div class="flex items-center gap-3 text-[11.5px] text-muted/70 border border-line rounded px-3 py-2">
            <span class="text-accent/60">&#10003;</span>
            <span class="flex-1 min-w-0 truncate"><%= i.name %> &middot; <%= i.email %></span>
            <span class="font-mono text-[10px] flex-shrink-0">accepted</span>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<script>
  document.querySelectorAll('.copy-link').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var link = btn.getAttribute('data-link');
      // navigator.clipboard needs a secure context, which localhost is but a
      // plain-http LAN address is not — fall back rather than doing nothing.
      var done = function () {
        var was = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = was; }, 1400);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(link).then(done);
      } else {
        var t = document.createElement('textarea');
        t.value = link;
        document.body.appendChild(t);
        t.select();
        document.execCommand('copy');
        document.body.removeChild(t);
        done();
      }
    });
  });
</script>
</body>
</html>
