<%- include('partials/head', { pageTitle: 'Create your account — 2w12.one', loggedIn: false }) %>

<div class="max-w-md mx-auto px-5 py-16">
  <h1 class="text-[26px] font-bold tracking-tight leading-tight">Create your account</h1>
  <p class="text-[12.5px] text-muted mt-3 leading-relaxed">
    You were invited to build a portfolio on 2w12.one. Pick a password and your portfolio is ready to fill in.
  </p>

  <% if (error) { %>
    <div class="mt-5 text-xs text-red-400 bg-red-950/40 border border-red-900 rounded px-3 py-2"><%= error %></div>
  <% } %>

  <form method="POST" class="mt-7 space-y-4">
    <div>
      <label class="block text-xs text-muted mb-1">Email</label>
      <input type="email" value="<%= invite.email %>" disabled class="w-full bg-bg/60 border border-line rounded px-3 py-2 text-sm text-muted cursor-not-allowed">
      <div class="text-[10px] text-muted/60 mt-1">Set by whoever invited you &mdash; this is your login.</div>
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Your name</label>
      <input type="text" name="name" value="<%= invite.name %>" required class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Password</label>
      <input type="password" name="password" required minlength="8" autocomplete="new-password" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
      <div class="text-[10px] text-muted/60 mt-1">At least 8 characters.</div>
    </div>
    <div>
      <label class="block text-xs text-muted mb-1">Confirm password</label>
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password" class="w-full bg-surface border border-line rounded px-3 py-2 text-sm focus:outline-none focus:border-accent">
    </div>
    <button type="submit" class="w-full bg-accent text-bg text-sm font-medium rounded px-4 py-2.5 hover:brightness-110 transition">Create account</button>
  </form>

  <a href="/" class="block mt-6 text-[11px] font-mono uppercase tracking-wider text-muted hover:text-accent transition-colors">&larr; 2w12.one</a>
</div>
</body>
</html>
