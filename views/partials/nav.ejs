<%
  // Menu data. The owner's portfolio lives at /portfolio; anyone else at
  // /p/:token until Phase 2 gives profiles real slugs.
  var navList = typeof navProfiles !== 'undefined' && navProfiles ? navProfiles : [];
  var navPrimary = navList.filter(function (p) { return p.user_id; })[0];
%>
<nav class="sticky top-0 z-40 bg-bg/95 backdrop-blur border-b border-line">
  <div class="max-w-[1500px] mx-auto px-6 md:px-10 lg:px-14 h-14 flex items-center justify-between gap-6">

    <a href="/" class="logo-glitch text-[17px] font-bold tracking-[-0.02em] flex-shrink-0" data-text="2w12.one">2w12.one</a>

    <!-- Desktop menu -->
    <div class="hidden md:flex items-center gap-1 text-[12.5px]">
      <div class="menu" data-menu>
        <button type="button" class="menu-btn" data-menu-btn aria-expanded="false">
          Portfolios
          <svg viewBox="0 0 24 24" class="w-3 h-3 menu-caret" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6,9 12,15 18,9"/></svg>
        </button>
        <div class="menu-panel">
          <% navList.forEach(function (p) { %>
            <a href="<%= navPrimary && p.id === navPrimary.id ? '/portfolio' : '/p/' + p.token %>" class="menu-item"><%= p.name %></a>
          <% }) %>
          <% if (!navList.length) { %><span class="menu-item text-muted/60">No portfolios yet</span><% } %>
          <div class="menu-sep"></div>
          <a href="<%= navPrimary ? '/portfolio/gallery' : '/gallery' %>" class="menu-item">Portfolio gallery</a>
        </div>
      </div>

      <a href="/work" class="menu-btn">Work <span class="text-accent/70 font-mono text-[9px] uppercase tracking-wider ml-0.5">soon</span></a>
      <a href="/gallery" class="menu-btn">Gallery</a>

      <div class="menu" data-menu>
        <button type="button" class="menu-btn" data-menu-btn aria-expanded="false">
          Tools
          <svg viewBox="0 0 24 24" class="w-3 h-3 menu-caret" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6,9 12,15 18,9"/></svg>
        </button>
        <div class="menu-panel">
          <a href="/tools/visualizer/" class="menu-item">Visualizer</a>
          <a href="/tools/keyfinder/" class="menu-item">Key Finder</a>
          <a href="/tools/youtube/" class="menu-item">YouTube</a>
          <div class="menu-sep"></div>
          <a href="https://github.com/venkateshW2/sonifyv.1" target="_blank" rel="noopener" class="menu-item">SonifyV1 &nearr;</a>
          <a href="https://venkateshw2.github.io/wall-harpDesigner/" target="_blank" rel="noopener" class="menu-item">Wall Harp &nearr;</a>
          <a href="https://github.com/venkateshW2/2w12-backend" target="_blank" rel="noopener" class="menu-item">Audio Analysis &nearr;</a>
        </div>
      </div>

      <span class="w-px h-4 bg-line mx-2"></span>

      <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
        <% if (typeof navIsAdmin !== 'undefined' && navIsAdmin) { %>
          <a href="/admin" class="menu-btn">Admin</a>
        <% } %>
        <a href="/dashboard" class="menu-btn text-accent">Dashboard</a>
        <form method="POST" action="/logout" class="inline"><button type="submit" class="menu-btn">Logout</button></form>
      <% } else { %>
        <a href="/login" class="menu-btn">Login</a>
      <% } %>
    </div>

    <!-- Mobile -->
    <button type="button" id="nav-burger" class="md:hidden text-muted hover:text-accent transition-colors" aria-label="Menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>
  </div>

  <div id="nav-mobile" class="md:hidden hidden border-t border-line bg-bg">
    <div class="px-6 py-4 space-y-1 text-[13.5px]">
      <div class="side-label mb-1.5">Portfolios</div>
      <% navList.forEach(function (p) { %>
        <a href="<%= navPrimary && p.id === navPrimary.id ? '/portfolio' : '/p/' + p.token %>" class="block py-1.5 text-muted hover:text-accent transition-colors"><%= p.name %></a>
      <% }) %>
      <div class="side-label mb-1.5 pt-3">Studio</div>
      <a href="/work" class="block py-1.5 text-muted hover:text-accent transition-colors">Work &mdash; soon</a>
      <a href="/gallery" class="block py-1.5 text-muted hover:text-accent transition-colors">Gallery</a>
      <div class="side-label mb-1.5 pt-3">Tools</div>
      <a href="/tools/visualizer/" class="block py-1.5 text-muted hover:text-accent transition-colors">Visualizer</a>
      <a href="/tools/keyfinder/" class="block py-1.5 text-muted hover:text-accent transition-colors">Key Finder</a>
      <a href="/tools/youtube/" class="block py-1.5 text-muted hover:text-accent transition-colors">YouTube</a>
      <div class="pt-3 border-t border-line mt-3">
        <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
          <a href="/dashboard" class="block py-1.5 text-accent">Dashboard</a>
          <form method="POST" action="/logout"><button type="submit" class="block py-1.5 text-muted hover:text-accent transition-colors">Logout</button></form>
        <% } else { %>
          <a href="/login" class="block py-1.5 text-muted hover:text-accent transition-colors">Login</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    // Click to open, not hover — hover menus are unusable on touch and jumpy
    // on the way to a neighbouring item.
    var menus = Array.prototype.slice.call(document.querySelectorAll('[data-menu]'));
    function closeAll(except) {
      menus.forEach(function (m) {
        if (m === except) return;
        m.classList.remove('open');
        m.querySelector('[data-menu-btn]').setAttribute('aria-expanded', 'false');
      });
    }
    menus.forEach(function (m) {
      var btn = m.querySelector('[data-menu-btn]');
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = m.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        closeAll(m);
      });
    });
    document.addEventListener('click', function () { closeAll(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

    var burger = document.getElementById('nav-burger');
    var mobile = document.getElementById('nav-mobile');
    if (burger) {
      burger.addEventListener('click', function () {
        var hidden = mobile.classList.toggle('hidden');
        burger.setAttribute('aria-expanded', hidden ? 'false' : 'true');
      });
    }
  })();
</script>
