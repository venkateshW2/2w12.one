<%
  // Dashboard section switcher. Login lands on Edit portfolio; the rest are
  // skeletons so the shape of the product is visible before it's built.
  var dashSections = [
    { slug: '',      href: '/dashboard',           label: 'Edit portfolio', soon: false },
    { slug: 'files', href: '/dashboard/files',     label: 'Send your files', soon: true },
    { slug: 'share', href: '/dashboard/share',     label: 'Share for feedback', soon: true },
    { slug: 'tools', href: '/dashboard/tools',     label: 'Your tools', soon: true }
  ];
  var dashActive = typeof active !== 'undefined' ? active : '';
%>
<div class="border-b border-line mb-8 -mt-1">
  <div class="flex items-end gap-0.5 overflow-x-auto no-scrollbar">
    <% dashSections.forEach(function (s) { %>
      <a href="<%= s.href %>" class="cat-tab <%= dashActive === s.slug ? 'active' : '' %>">
        <%= s.label %><% if (s.soon) { %> <span class="tab-count text-accent/70">soon</span><% } %>
      </a>
    <% }) %>
  </div>
</div>
