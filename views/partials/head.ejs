<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : '2w12.one' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bg: '#0c0c0c',
            surface: '#141414',
            line: '#232323',
            ink: '#e8e6e1',
            muted: '#86837c',
            accent: '#c98a3f'
          },
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
          }
        }
      }
    };
  </script>
  <style>
    body { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    #lightbox.open { display: flex; }

    /* Folder tabs — the tab sits on the rule, active one joins it. */
    .cat-tab {
      position: relative; flex: 0 0 auto;
      padding: .45rem .8rem; border: 1px solid #232323; border-bottom-color: transparent;
      border-radius: 5px 5px 0 0; background: transparent;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px; text-transform: uppercase; letter-spacing: .09em;
      color: #86837c; white-space: nowrap; cursor: pointer;
      transition: color .2s ease, background .2s ease, border-color .2s ease;
    }
    .cat-tab:hover { color: #e8e6e1; background: #141414; }
    .cat-tab.active { color: #c98a3f; background: #141414; border-color: #2e2e2e; border-bottom-color: #141414; z-index: 1; }
    .cat-tab.active::after {
      content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 2px; background: #c98a3f;
      border-radius: 5px 5px 0 0;
    }
    .tab-count { opacity: .45; font-size: 9px; margin-left: .15rem; }
    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* Fades + arrows telling you the tab strip scrolls past the edge. */
    .tab-fade { pointer-events: none; opacity: 0; transition: opacity .2s ease; }
    .tab-fade.on { opacity: 1; }
    .tab-arrow { transition: opacity .2s ease, color .2s ease; }
    .tab-arrow[disabled] { opacity: .2; cursor: default; }

    /* Gallery masonry — CSS columns so mixed aspect ratios tile uncropped. */
    .gallery-masonry { column-count: 2; column-gap: .75rem; }
    @media (min-width: 640px) { .gallery-masonry { column-count: 3; } }
    @media (min-width: 1024px) { .gallery-masonry { column-count: 4; } }
    .gal-item { cursor: pointer; transition: transform .25s ease, border-color .25s ease; }
    .gal-item:hover { transform: translateY(-2px); border-color: #2e2e2e; }

    /* Header menu */
    .menu { position: relative; }
    .menu-btn {
      display: inline-flex; align-items: center; gap: .3rem;
      padding: .45rem .7rem; border-radius: 4px; background: none; border: 0;
      color: #86837c; text-decoration: none; font-size: 12.5px; cursor: pointer;
      transition: color .18s ease, background .18s ease;
    }
    .menu-btn:hover { color: #e8e6e1; background: #141414; }
    .menu-caret { transition: transform .2s ease; }
    .menu.open .menu-btn { color: #c98a3f; background: #141414; }
    .menu.open .menu-caret { transform: rotate(180deg); }
    .menu-panel {
      position: absolute; top: calc(100% + .35rem); left: 0; min-width: 190px;
      background: #141414; border: 1px solid #232323; border-radius: 6px;
      padding: .35rem; box-shadow: 0 12px 32px rgba(0,0,0,.55);
      opacity: 0; visibility: hidden; transform: translateY(-4px);
      transition: opacity .18s ease, transform .18s ease, visibility .18s;
    }
    .menu.open .menu-panel { opacity: 1; visibility: visible; transform: none; }
    .menu-item {
      display: block; padding: .45rem .6rem; border-radius: 4px;
      color: #b8b5ae; text-decoration: none; font-size: 12.5px; white-space: nowrap;
      transition: color .15s ease, background .15s ease;
    }
    .menu-item:hover { color: #c98a3f; background: #1b1b1b; }
    .menu-sep { height: 1px; background: #232323; margin: .35rem .3rem; }

    /* Small uppercase mono label, used across the landing and gallery. */
    .side-label {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px; text-transform: uppercase; letter-spacing: .2em; color: #6e6b64;
    }

    /* Glitch — the studio's existing motif, carried over from the old landing
       page (which used --glitch-color #ff0080) and re-tuned for dark. */
    .logo-glitch, .glitch { position: relative; color: #e8e6e1; }
    .logo-glitch { color: #ffffff; } /* the company name stays white */
    .logo-glitch::before, .logo-glitch::after,
    .glitch::before, .glitch::after {
      content: attr(data-text); position: absolute; top: 0; left: 0;
      width: 100%; overflow: hidden; pointer-events: none;
    }
    .logo-glitch::before, .glitch::before { color: #ff0080; z-index: -1; }
    .logo-glitch::after, .glitch::after { color: #00e5ff; z-index: -2; }

    .logo-glitch::before { animation: glitch-a 2.6s infinite steps(1); }
    .logo-glitch::after { animation: glitch-b 3.1s infinite steps(1); }
    .glitch::before { animation: glitch-a 4s infinite steps(1); }
    .glitch::after { animation: glitch-b 4.7s infinite steps(1); }

    /* Mostly at rest, with brief slips — a constant shimmer reads as broken. */
    @keyframes glitch-a {
      0%, 92%, 100% { transform: none; clip-path: none; }
      93% { transform: translate(-2px, 1px); clip-path: inset(20% 0 55% 0); }
      95% { transform: translate(2px, -1px); clip-path: inset(65% 0 15% 0); }
      97% { transform: translate(-1px, 0); clip-path: inset(40% 0 40% 0); }
    }
    @keyframes glitch-b {
      0%, 90%, 100% { transform: none; clip-path: none; }
      91% { transform: translate(2px, -1px); clip-path: inset(70% 0 10% 0); }
      94% { transform: translate(-2px, 1px); clip-path: inset(10% 0 70% 0); }
      96% { transform: translate(1px, 1px); clip-path: inset(45% 0 35% 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .logo-glitch::before, .logo-glitch::after, .glitch::before, .glitch::after { animation: none; display: none; }
    }
    .filter-chip.active { border-color: #c98a3f; color: #c98a3f; }

    /* Project cards — ported from the old static site's interaction: hover
       lift, an accent bar that sweeps across the top edge, and click-to-expand
       revealing the full project metadata. */
    .project-card { transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
    .project-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,.45); border-color: #2e2e2e; }
    .project-card::before {
      content: ''; position: absolute; top: 0; left: 0; width: 0; height: 2px;
      background: #c98a3f; transition: width .3s ease; z-index: 2;
    }
    .project-card:hover::before, .project-card.expanded::before { width: 100%; }
    .project-card:hover .project-title { color: #c98a3f; }

    .card-img { filter: saturate(.9) brightness(.85); transition: filter .3s ease, transform .4s ease; }
    .project-card:hover .card-img { filter: saturate(1) brightness(.62); transform: scale(1.04); }

    /* Collapsed: clamp the blurb so every card in a row is the same height.
       Expanded: release it and reveal the metadata block. */
    .card-desc {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden; transition: -webkit-line-clamp .3s ease;
    }
    .project-card.expanded .card-desc { -webkit-line-clamp: 99; }

    .card-details {
      max-height: 0; opacity: 0; overflow: hidden;
      transition: max-height .35s cubic-bezier(.4,0,.2,1), opacity .25s ease;
    }
    .project-card.expanded .card-details { max-height: 640px; opacity: 1; }

    /* Solo / all-departments work reads differently from a single credit
       among many: a persistent accent edge rather than a hover-only cue. */
    .project-card.solo-credit { border-color: rgba(201,138,63,.45); }
    .project-card.solo-credit::after {
      content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 2px;
      background: linear-gradient(to bottom, #c98a3f, rgba(201,138,63,.15)); z-index: 2;
    }
    .project-card.solo-credit:hover { border-color: rgba(201,138,63,.8); }

    .expand-indicator { transition: transform .3s ease, color .3s ease; }
    .project-card.expanded .expand-indicator { transform: rotate(45deg); color: #c98a3f; }

    @media (prefers-reduced-motion: reduce) {
      .project-card, .project-card::before, .card-img, .card-details, .expand-indicator { transition: none; }
      .project-card:hover { transform: none; }
    }
  </style>
</head>
<body class="bg-bg text-ink font-sans antialiased min-h-screen">
  <%- include('nav', { loggedIn: typeof loggedIn !== 'undefined' ? loggedIn : false }) %>
