<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : '2w12.one' %></title>

  <%# Open Graph / Twitter cards. This is what actually renders when someone
      pastes the link into WhatsApp, Slack, iMessage or a DM — without it a
      shared link is just a bare URL, which is the whole problem with sending
      someone a portfolio. og:image must be an ABSOLUTE url and should be jpg
      or png; WebP preview support is still patchy across scrapers. %>
  <meta property="og:site_name" content="2w12.one">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : (typeof pageTitle !== 'undefined' ? pageTitle : '2w12.one') %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : 'All things sound.' %>">
  <% if (typeof ogUrl !== 'undefined' && ogUrl) { %><meta property="og:url" content="<%= ogUrl %>"><% } %>
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <meta name="twitter:card" content="summary_large_image">
  <% } else { %>
    <meta name="twitter:card" content="summary">
  <% } %>
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : '2w12.one' %>">
  <meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : 'All things sound.' %>">
  <% if (typeof ogDescription !== 'undefined' && ogDescription) { %><meta name="description" content="<%= ogDescription %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bg: '#0c0c0c',
            surface: '#141414',
            line: '#232323',
            ink: '#e8e6e1',
            muted: '#86837c',
            accent: '#c98a3f'
          },
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
          }
        }
      }
    };
  </script>
  <style>
    body { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    #lightbox.open { display: flex; }

    /* Folder tabs — the tab sits on the rule, active one joins it. */
    .cat-tab {
      position: relative; flex: 0 0 auto;
      padding: .45rem .8rem; border: 1px solid #232323; border-bottom-color: transparent;
      border-radius: 5px 5px 0 0; background: transparent;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px; text-transform: uppercase; letter-spacing: .09em;
      color: #86837c; white-space: nowrap; cursor: pointer;
      transition: color .2s ease, background .2s ease, border-color .2s ease;
    }
    .cat-tab:hover { color: #e8e6e1; background: #141414; }
    .cat-tab.active { color: #c98a3f; background: #141414; border-color: #2e2e2e; border-bottom-color: #141414; z-index: 1; }
    .cat-tab.active::after {
      content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 2px; background: #c98a3f;
      border-radius: 5px 5px 0 0;
    }
    .tab-count { opacity: .45; font-size: 9px; margin-left: .15rem; }
    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* Fades + arrows telling you the tab strip scrolls past the edge. */
    .tab-fade { pointer-events: none; opacity: 0; transition: opacity .2s ease; }
    .tab-fade.on { opacity: 1; }
    .tab-arrow { transition: opacity .2s ease, color .2s ease; }
    .tab-arrow[disabled] { opacity: .2; cursor: default; }

    /* Gallery masonry — CSS columns so mixed aspect ratios tile uncropped. */
    .gallery-masonry { column-count: 2; column-gap: .75rem; }
    @media (min-width: 640px) { .gallery-masonry { column-count: 3; } }
    @media (min-width: 1024px) { .gallery-masonry { column-count: 4; } }
    .gal-item { cursor: pointer; transition: transform .25s ease, border-color .25s ease; }
    .gal-item:hover { transform: translateY(-2px); border-color: #2e2e2e; }

    /* Header menu — same padding as before, larger and heavier text. */
    .menu { position: relative; }
    .menu-btn {
      position: relative;
      display: inline-flex; align-items: center; gap: .3rem;
      padding: .45rem .7rem; border-radius: 4px; background: none; border: 0;
      color: #9a968e; text-decoration: none;
      font-size: 14.5px; font-weight: 600; letter-spacing: -.008em; cursor: pointer;
      transition: color .18s ease, background .18s ease;
    }
    .menu-btn:hover { color: #e8e6e1; background: #141414; }

    /* Where you are. The rule has to stay INSIDE the 56px header: the button is
       ~32px tall and centred, so its bottom edge sits ~12px above the header
       border. -1.05rem put the rule 4.7px past that border, where it painted
       over the page content below (the portfolio's tab strip). */
    .menu-btn.here { color: #e8e6e1; }
    .menu-btn.here::after {
      content: ''; position: absolute; left: .7rem; right: .7rem; bottom: -.55rem;
      height: 2px; background: #c98a3f; border-radius: 2px;
    }
    .menu-caret { transition: transform .2s ease; }
    .menu.open .menu-btn { color: #c98a3f; background: #141414; }
    .menu.open .menu-caret { transform: rotate(180deg); }
    .menu-panel {
      position: absolute; top: calc(100% + .35rem); left: 0; min-width: 190px;
      background: #141414; border: 1px solid #232323; border-radius: 6px;
      padding: .35rem; box-shadow: 0 12px 32px rgba(0,0,0,.55);
      opacity: 0; visibility: hidden; transform: translateY(-4px);
      transition: opacity .18s ease, transform .18s ease, visibility .18s;
    }
    .menu.open .menu-panel { opacity: 1; visibility: visible; transform: none; }
    .menu-item {
      display: block; padding: .5rem .65rem; border-radius: 4px;
      color: #b8b5ae; text-decoration: none; font-size: 13.5px; font-weight: 500; white-space: nowrap;
      transition: color .15s ease, background .15s ease;
    }
    .menu-item:hover { color: #c98a3f; background: #1b1b1b; }
    .menu-sep { height: 1px; background: #232323; margin: .35rem .3rem; }

    /* Small uppercase mono label, used across the landing and gallery. */
    .side-label {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 10px; text-transform: uppercase; letter-spacing: .2em; color: #6e6b64;
    }

    /* Glitch — horizontal slice displacement.
       The previous version parked two coloured copies behind the text with
       z-index:-1/-2, so their fringes were visible the whole time and it read
       as an overlay rather than a glitch. Here the copies sit ON TOP, painted
       with the page background so they occlude what's beneath, and are clipped
       to nothing except during a slip. What you see is a band of the word
       jumping sideways and the rest holding still. */
    .logo-glitch, .glitch { position: relative; display: inline-block; }
    .logo-glitch { color: #ffffff; }

    .logo-glitch::before, .logo-glitch::after,
    .glitch::before, .glitch::after {
      content: attr(data-text);
      position: absolute; top: 0; left: 0; width: 100%;
      background: #0c0c0c;
      color: inherit;
      clip-path: inset(50% 0 50% 0); /* collapsed = invisible */
      pointer-events: none;
    }

    .glitch::before { animation: slice-a 3.4s infinite steps(1); }
    .glitch::after  { animation: slice-b 4.1s infinite steps(1); }
    .glitch         { animation: shake 3.4s infinite steps(1); }

    /* Bands cut at different heights, shoved opposite ways, with a chromatic
       edge only while they're displaced. */
    @keyframes slice-a {
      0%, 100%  { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      6%        { clip-path: inset(14% 0 74% 0); transform: translateX(-9px); text-shadow: 3px 0 #ff0080; }
      8%        { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      27%       { clip-path: inset(58% 0 28% 0); transform: translateX(7px);  text-shadow: -3px 0 #00e5ff; }
      29%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      52%       { clip-path: inset(36% 0 50% 0); transform: translateX(-13px); text-shadow: 4px 0 #ff0080; }
      54%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      55%       { clip-path: inset(70% 0 16% 0); transform: translateX(5px); }
      56.5%     { clip-path: inset(50% 0 50% 0); transform: none; }
      78%       { clip-path: inset(24% 0 62% 0); transform: translateX(10px); text-shadow: -2px 0 #00e5ff; }
      80%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
    }
    @keyframes slice-b {
      0%, 100%  { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      12%       { clip-path: inset(66% 0 20% 0); transform: translateX(11px); text-shadow: -3px 0 #00e5ff; }
      14%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      34%       { clip-path: inset(8% 0 80% 0);  transform: translateX(-7px); text-shadow: 3px 0 #ff0080; }
      35.5%     { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      63%       { clip-path: inset(46% 0 40% 0); transform: translateX(14px); text-shadow: -4px 0 #ff0080; }
      65%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      66%       { clip-path: inset(18% 0 68% 0); transform: translateX(-6px); }
      67.5%     { clip-path: inset(50% 0 50% 0); transform: none; }
      91%       { clip-path: inset(78% 0 8% 0);  transform: translateX(8px);  text-shadow: 2px 0 #00e5ff; }
      93%       { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
    }
    /* The word itself only twitches on the frames where a slice lands, so the
       whole thing moves as one event instead of drifting constantly. */
    @keyframes shake {
      0%, 100%      { transform: none; }
      6%            { transform: translate(2px, -1px); }
      8%            { transform: none; }
      52%           { transform: translate(-3px, 1px) skewX(2deg); }
      54%           { transform: none; }
      63%           { transform: translate(2px, 1px) skewX(-2deg); }
      65%           { transform: none; }
    }

    /* Nav wordmark: same technique, far rarer — a permanently glitching header
       reads as a broken page. */
    .logo-glitch::before { animation: slice-nav-a 7s infinite steps(1); }
    .logo-glitch::after  { animation: slice-nav-b 9s infinite steps(1); }
    @keyframes slice-nav-a {
      0%, 100% { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      93%      { clip-path: inset(20% 0 62% 0); transform: translateX(-4px); text-shadow: 2px 0 #ff0080; }
      95%      { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
    }
    @keyframes slice-nav-b {
      0%, 100% { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
      96%      { clip-path: inset(64% 0 22% 0); transform: translateX(4px); text-shadow: -2px 0 #00e5ff; }
      98%      { clip-path: inset(50% 0 50% 0); transform: none; text-shadow: none; }
    }

    /* Terminal typing. The block cursor and the prompt keep blinking once the
       lines have finished, so the panel reads as waiting for input rather than
       as a finished screenshot. */
    .term-cursor { display: inline-block; color: #c98a3f; animation: term-blink 1.05s steps(1) infinite; }
    @keyframes term-blink { 0%, 52% { opacity: 1; } 53%, 100% { opacity: 0; } }

    /* Prompt blinks on the same beat, slightly dimmer at its low point so the
       two read as one caret rather than two things flashing. */
    .term-prompt { animation: prompt-blink 1.05s steps(1) infinite; }
    @keyframes prompt-blink { 0%, 52% { opacity: 1; } 53%, 100% { opacity: .28; } }

    /* Activity LED — slower, softer pulse than the caret. */
    .term-led { animation: led-pulse 1.9s ease-in-out infinite; }
    @keyframes led-pulse {
      0%, 100% { opacity: .28; box-shadow: none; }
      50%      { opacity: 1;   box-shadow: 0 0 7px rgba(201,138,63,.85); }
    }

    @media (prefers-reduced-motion: reduce) {
      .logo-glitch::before, .logo-glitch::after, .glitch::before, .glitch::after { animation: none; display: none; }
      .glitch { animation: none; }
      .term-cursor, .term-led { animation: none; }
    }
    .filter-chip.active { border-color: #c98a3f; color: #c98a3f; }

    /* Project cards — ported from the old static site's interaction: hover
       lift, an accent bar that sweeps across the top edge, and click-to-expand
       revealing the full project metadata. */
    .project-card { transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
    .project-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,.45); border-color: #2e2e2e; }
    .project-card::before {
      content: ''; position: absolute; top: 0; left: 0; width: 0; height: 2px;
      background: #c98a3f; transition: width .3s ease; z-index: 2;
    }
    .project-card:hover::before, .project-card.expanded::before { width: 100%; }
    .project-card:hover .project-title { color: #c98a3f; }

    .card-img { filter: saturate(.9) brightness(.85); transition: filter .3s ease, transform .4s ease; }
    .project-card:hover .card-img { filter: saturate(1) brightness(.62); transform: scale(1.04); }

    /* Every collapsed card is the same size — a fixed body height plus the
       fixed 16/9 poster. The grid uses items-start (so expanding one card can't
       stretch its neighbours), which means uniformity has to come from the card
       itself rather than from the row. */
    .card-body { min-height: 9.5rem; }

    /* Two lines each, always. The blurb used to unclamp on expand with a
       transition on -webkit-line-clamp — which is not an animatable property,
       so it snapped and shunted everything below it mid-animation. That was
       most of the jerkiness. */
    .card-title {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-desc {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    /* 0fr -> 1fr animates to the content's exact height. max-height:640px was
       the other half of the problem: content shorter than 640px finished early
       and the rest of the duration did nothing, so the motion looked like it
       stalled. */
    .card-details {
      display: grid; grid-template-rows: 0fr; opacity: 0;
      transition: grid-template-rows .34s cubic-bezier(.32,.72,0,1), opacity .22s ease;
    }
    .card-details > * { overflow: hidden; }
    .project-card.expanded .card-details { grid-template-rows: 1fr; opacity: 1; }

    /* Solo / all-departments work reads differently from a single credit
       among many: a persistent accent edge rather than a hover-only cue. */
    .project-card.solo-credit { border-color: rgba(201,138,63,.45); }
    .project-card.solo-credit::after {
      content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 2px;
      background: linear-gradient(to bottom, #c98a3f, rgba(201,138,63,.15)); z-index: 2;
    }
    .project-card.solo-credit:hover { border-color: rgba(201,138,63,.8); }

    .expand-indicator { transition: transform .3s ease, color .3s ease; }
    .project-card.expanded .expand-indicator { transform: rotate(45deg); color: #c98a3f; }

    @media (prefers-reduced-motion: reduce) {
      .project-card, .project-card::before, .card-img, .card-details, .expand-indicator { transition: none; }
      .project-card:hover { transform: none; }
    }

    /* Cards animate their own height, so the browser shouldn't also be trying
       to reflow the whole grid on every frame. */
    .project-card { contain: layout paint; }
  </style>
</head>
<body class="bg-bg text-ink font-sans antialiased min-h-screen">
  <%- include('nav', { loggedIn: typeof loggedIn !== 'undefined' ? loggedIn : false }) %>
