# Copy this to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

SESSION_SECRET=change-me-to-something-random
PORT=3060

# Leave DATABASE_URL unset to use local SQLite (fine for local dev).
# On Render, add a Postgres instance and paste its Internal Database URL here.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Backblaze B2 (S3-compatible). Get these from your B2 bucket's settings.
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# Optional: only set this if you're fronting the bucket with a CDN/custom domain
# instead of the raw B2 endpoint.
# B2_PUBLIC_BASE_URL=
